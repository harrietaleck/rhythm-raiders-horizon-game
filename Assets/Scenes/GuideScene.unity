      m_Calls: []
  m_text: 'Jump the <color=#FF6B5A>roof gaps</color> (red edges and steel bars mark
    them) or ride a <color=#5AD9FF>zip-line</color>. Dodge AC units, water tanks
    and laundry lines. <color=#5AD9FF>DJ stations</color> blast <color=#FF6B5A>smoke</color>
    across the lanes. Centre DJ stages have a <color=#FF6B5A>taser bodyguard</color>
    on one side - jump him or take the other lane.

    <color=#5AD9FF>10 shield</color>
    hits before Vibe starts dropping.'
  m_isRightToLeft: 0
