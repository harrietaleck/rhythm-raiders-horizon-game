      m_Calls: []
  m_text: 'Jump <color=#FF6B5A>laser fences</color>, dodge speaker stacks, cross
    <color=#FF6B5A>bass walls</color> when they go dark. Watch for sweeping lasers,
    falling light rigs and <color=#FF6B5A>disco balls</color> that drop and roll
    down a lane. DJ stages, bouncers and smoke on the dance floor.

    Start with
    <color=#5AD9FF>6 shield</color> - it burns off as you run, so keep grabbing shield
    orbs.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 78a46f381c4f2cc4f809961b9c12f0d9, type: 2}
