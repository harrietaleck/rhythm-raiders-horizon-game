  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<color=#FF6B5A>Armed guards</color> aim a red laser - strafe out of it.
    <color=#FF6B5A>Grenadiers</color> throw grenades: when a red ring lands in your
    lane, switch lanes. Jump <color=#FF6B5A>low lasers</color> and <color=#FF6B5A>planted
    grenades</color>, dodge laser grids. Smash glass cases: <color=#5AD9FF>cyan</color>
    = boost, <color=#FF6B5A>red</color> = sour note, purple = gamble.

    <color=#5AD9FF>7
    shield</color> hits before Vibe starts dropping.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 78a46f381c4f2cc4f809961b9c12f0d9, type: 2}
